@using McpAgent.XClient.Models
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="elicitation-overlay" @onclick="HandleOverlayClick">
        <div class="elicitation-modal" @onclick:stopPropagation="true">
            <div class="elicitation-header">
                <h3 class="elicitation-title">@State.Title</h3>
                <button class="close-button" @onclick="OnCancel" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>

            <div class="elicitation-content">
                <div class="elicitation-message">
                    <p>@State.Message</p>
                </div>

                <div class="elicitation-form">
                    @foreach (var field in State.Fields)
                    {
                        <div class="form-group">
                            <label class="field-label @(field.IsRequired ? "required" : "")">
                                @field.Title
                                @if (field.IsRequired)
                                {
                                    <span class="required-indicator">*</span>
                                }
                            </label>
                            
                            @if (!string.IsNullOrEmpty(field.Description))
                            {
                                <div class="field-description">@field.Description</div>
                            }

                            @switch (field.Type.ToLowerInvariant())
                            {
                                case "string":
                                    @if (field.Options?.Any() == true)
                                    {
                                        <select @bind="field.Value" class="form-control select-input">
                                            <option value="">-- Select an option --</option>
                                            @for (int i = 0; i < field.Options.Count; i++)
                                            {
                                                var option = field.Options[i];
                                                var label = field.OptionLabels?.Count > i ? field.OptionLabels[i] : option;
                                                <option value="@option">@label</option>
                                            }
                                        </select>
                                    }
                                    else if (field.Format == "email")
                                    {
                                        <input type="email" @bind="field.Value" class="form-control" 
                                               placeholder="Enter email address" />
                                    }
                                    else if (field.Format == "date")
                                    {
                                        <input type="date" @bind="field.Value" class="form-control" />
                                    }
                                    else
                                    {
                                        <input type="text" @bind="field.Value" class="form-control" 
                                               placeholder="@GetPlaceholder(field)" 
                                               minlength="@field.MinLength" 
                                               maxlength="@field.MaxLength" />
                                    }
                                    break;

                                case "number":
                                case "integer":
                                    <input type="number" @bind="field.Value" class="form-control" 
                                           min="@field.MinValue" max="@field.MaxValue" 
                                           placeholder="@GetPlaceholder(field)" />
                                    break;

                                case "boolean":
                                    <div class="checkbox-wrapper">
                                        <input type="checkbox" @bind="field.Value" id="@($"field_{field.Name}")" />
                                        <label for="@($"field_{field.Name}")">@field.Description</label>
                                    </div>
                                    break;

                                default:
                                    <textarea @bind="field.Value" class="form-control textarea-input" 
                                              placeholder="@GetPlaceholder(field)" rows="3"></textarea>
                                    break;
                            }

                            @if (!string.IsNullOrEmpty(field.ValidationMessage))
                            {
                                <div class="validation-error">@field.ValidationMessage</div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="elicitation-footer">
                <div class="button-group">
                    <button class="btn btn-secondary" @onclick="OnCancel" disabled="@State.IsSubmitting">
                        Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="OnReject" disabled="@State.IsSubmitting">
                        Reject
                    </button>
                    <button class="btn btn-primary" @onclick="OnAccept" disabled="@State.IsSubmitting">
                        @if (State.IsSubmitting)
                        {
                            <span class="spinner"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>✓ Confirm & Execute</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .elicitation-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        animation: fadeIn 0.3s ease-out;
    }

    .elicitation-modal {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        max-width: 600px;
        width: 90%;
        max-height: 80vh;
        overflow: hidden;
        color: white;
        animation: slideIn 0.3s ease-out;
    }

    .elicitation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 30px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .elicitation-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
    }

    .close-button {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.8rem;
        cursor: pointer;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .close-button:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .elicitation-content {
        padding: 0 30px;
        max-height: 50vh;
        overflow-y: auto;
    }

    .elicitation-message {
        padding: 20px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 25px;
    }

    .elicitation-message p {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.9);
    }

    .elicitation-form {
        padding-bottom: 25px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .field-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
    }

    .field-label.required {
        color: #ffeb3b;
    }

    .required-indicator {
        color: #ff6b6b;
        margin-left: 4px;
    }

    .field-description {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 8px;
        font-style: italic;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #4CAF50;
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.2);
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.5);
    }

    .select-input {
        cursor: pointer;
    }

    .textarea-input {
        resize: vertical;
        min-height: 80px;
    }

    .checkbox-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .checkbox-wrapper input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .validation-error {
        color: #ff6b6b;
        font-size: 0.85rem;
        margin-top: 5px;
        padding: 5px 10px;
        background: rgba(255, 107, 107, 0.1);
        border-radius: 5px;
        border-left: 3px solid #ff6b6b;
    }

    .elicitation-footer {
        padding: 25px 30px;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(0, 0, 0, 0.1);
    }

    .button-group {
        display: flex;
        gap: 15px;
        justify-content: flex-end;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .btn-secondary:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.3);
    }

    .btn-danger {
        background: #ff6b6b;
        color: white;
    }

    .btn-danger:hover:not(:disabled) {
        background: #ff5252;
        transform: translateY(-1px);
    }

    .btn-primary {
        background: #4CAF50;
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: #45a049;
        transform: translateY(-1px);
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top: 2px solid white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideIn {
        from { 
            opacity: 0;
            transform: translateY(-50px) scale(0.95);
        }
        to { 
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Scrollbar styling */
    .elicitation-content::-webkit-scrollbar {
        width: 6px;
    }

    .elicitation-content::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
    }

    .elicitation-content::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.3);
        border-radius: 3px;
    }

    .elicitation-content::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.5);
    }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public ElicitationUIState State { get; set; } = new();
    [Parameter] public EventCallback<string> OnAction { get; set; }

    private async Task OnAccept()
    {
        if (State.IsSubmitting) return;

        // Validate all required fields
        var validationErrors = new Dictionary<string, string>();
        foreach (var field in State.Fields.Where(f => f.IsRequired))
        {
            if (field.Value == null || string.IsNullOrWhiteSpace(field.Value.ToString()))
            {
                validationErrors[field.Name] = $"{field.Title} is required";
            }
        }

        if (validationErrors.Any())
        {
            foreach (var error in validationErrors)
            {
                var field = State.Fields.FirstOrDefault(f => f.Name == error.Key);
                if (field != null)
                {
                    field.ValidationMessage = error.Value;
                }
            }
            StateHasChanged();
            return;
        }

        State.IsSubmitting = true;
        StateHasChanged();

        await OnAction.InvokeAsync("accept");
    }

    private async Task OnReject()
    {
        if (State.IsSubmitting) return;
        await OnAction.InvokeAsync("reject");
    }

    private async Task OnCancel()
    {
        if (State.IsSubmitting) return;
        await OnAction.InvokeAsync("cancel");
    }

    private async Task HandleOverlayClick()
    {
        await OnCancel();
    }

    private string GetPlaceholder(ElicitationField field)
    {
        return field.Type.ToLowerInvariant() switch
        {
            "number" => field.MinValue.HasValue && field.MaxValue.HasValue 
                ? $"Enter a number between {field.MinValue} and {field.MaxValue}"
                : "Enter a number",
            "string" when field.Format == "email" => "example@domain.com",
            "string" when field.Format == "date" => "YYYY-MM-DD",
            _ => $"Enter {field.Title.ToLowerInvariant()}"
        };
    }

    public void ClearValidationErrors()
    {
        foreach (var field in State.Fields)
        {
            field.ValidationMessage = null;
        }
        StateHasChanged();
    }

    public Dictionary<string, object?> GetFormData()
    {
        var data = new Dictionary<string, object?>();
        foreach (var field in State.Fields)
        {
            data[field.Name] = field.Value;
        }
        return data;
    }
}
