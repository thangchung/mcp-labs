@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@using McpAgent.XClient.Models
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<PageTitle>MCP Agent SignalR Chat</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <h1 class="chat-title">MCP Agent SignalR Chat</h1>
        <div class="connection-status">
            <span>Connection Status:</span>
            <span class="@(IsConnected ? "status-connected" : "status-disconnected")">
                @(IsConnected ? "Connected" : "Disconnected")
            </span>
        </div>
    </div>

    <div class="chat-content">
        <div class="messages-section">
            <div class="messages-container" id="messagesList">
                @if (messages.Count == 0)
                {
                    <div class="welcome-message">
                        <p>17:49:31 - System: Connected to SignalR Hub</p>
                    </div>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <div class="message">
                            <small class="message-time">@DateTime.Now.ToString("HH:mm:ss")</small>
                            <MarkdownRenderer Content="@message" CssClass="message-content" />
                        </div>
                    }
                }
            </div>
        </div>

        <div class="input-section">
            <div class="user-input">
                <label for="userInput">User:</label>
                <input @bind="userInput" id="userInput" class="form-control user-field" placeholder="User" />
            </div>
            
            <div class="message-input">
                <label for="messageInput">Message:</label>
                <textarea @bind="messageInput" id="messageInput" class="form-control message-field" 
                          placeholder="Type your message..." @onkeypress="HandleKeyPress"></textarea>
            </div>

            <div class="action-buttons">
                <button @onclick="Send" disabled="@(!IsConnected)" class="btn btn-primary send-btn">
                    Send Message
                </button>
                
                <button @onclick="TravelToTokyo" disabled="@(!IsConnected)" class="btn btn-success travel-btn">
                    ✈️ Travel to Tokyo
                </button>
                
                <button @onclick="ResearchAI" disabled="@(!IsConnected)" class="btn btn-info research-btn">
                    🔍 Research AI
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Simple Elicitation Modal -->
@if (elicitationState.IsVisible)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Information Required</h5>
                </div>
                <div class="modal-body">
                    <p>@elicitationState.Message</p>
                    
                    @if (elicitationState.Fields?.Any() == true)
                    {
                        <form>
                            @foreach (var field in elicitationState.Fields)
                            {
                                <div class="mb-3">
                                    <label class="form-label">
                                        @field.Name
                                        @if (field.Required)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    
                                    @if (!string.IsNullOrEmpty(field.Description))
                                    {
                                        <small class="form-text text-muted d-block">@field.Description</small>
                                    }
                                    
                                    <input type="text" class="form-control" @bind="field.Value" required="@field.Required" />
                                    
                                    @if (!string.IsNullOrEmpty(field.ErrorMessage))
                                    {
                                        <div class="text-danger small">@field.ErrorMessage</div>
                                    }
                                </div>
                            }
                        </form>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="@(() => HandleElicitationAction("decline"))">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="@(() => HandleElicitationAction("accept"))">
                        Submit
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<style>
    .chat-container {
        background: linear-gradient(135deg, #667add 0%, #9c88ff 100%);
        min-height: 100vh;
        padding: 20px;
        color: white;
    }

    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .chat-title {
        font-size: 2.5rem;
        font-weight: 300;
        margin: 0;
    }

    .connection-status {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1rem;
    }

    .status-connected {
        background: #28a745;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .status-disconnected {
        background: #dc3545;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .chat-content {
        display: flex;
        gap: 20px;
        height: calc(100vh - 200px);
    }

    .messages-section {
        flex: 1;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }

    .messages-container {
        height: 100%;
        overflow-y: auto;
        padding-right: 10px;
    }

    .welcome-message {
        opacity: 0.8;
        font-style: italic;
    }

    .message {
        margin-bottom: 15px;
        padding: 10px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }

    .message-time {
        opacity: 0.7;
        font-size: 0.85rem;
    }

    .message-content {
        margin-top: 5px;
        line-height: 1.4;
    }

    /* Markdown content styling */
    .message-content .markdown-content {
        color: inherit;
    }

    .message-content .markdown-content p {
        margin: 0.5em 0;
        color: inherit;
    }

    .message-content .markdown-content h1,
    .message-content .markdown-content h2,
    .message-content .markdown-content h3,
    .message-content .markdown-content h4,
    .message-content .markdown-content h5,
    .message-content .markdown-content h6 {
        color: #ffeb3b;
        margin: 0.8em 0 0.4em 0;
        font-weight: 600;
    }

    .message-content .markdown-content strong {
        color: #ffeb3b;
        font-weight: 700;
    }

    .message-content .markdown-content em {
        color: #e3f2fd;
        font-style: italic;
    }

    .message-content .markdown-content code {
        background: rgba(0, 0, 0, 0.3);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.9em;
        color: #fff;
    }

    .message-content .markdown-content pre {
        background: rgba(0, 0, 0, 0.4);
        padding: 15px;
        border-radius: 8px;
        overflow-x: auto;
        margin: 10px 0;
        border-left: 4px solid #007bff;
    }

    .message-content .markdown-content pre code {
        background: none;
        padding: 0;
        color: #fff;
    }

    .message-content .markdown-content ul,
    .message-content .markdown-content ol {
        margin: 10px 0;
        padding-left: 20px;
    }

    .message-content .markdown-content li {
        margin: 5px 0;
        color: inherit;
    }

    .message-content .markdown-content blockquote {
        border-left: 4px solid #28a745;
        margin: 10px 0;
        padding: 10px 15px;
        background: rgba(40, 167, 69, 0.1);
        font-style: italic;
    }

    .message-content .markdown-content a {
        color: #87ceeb;
        text-decoration: underline;
    }

    .message-content .markdown-content a:hover {
        color: #add8e6;
    }

    .message-content .markdown-content table {
        border-collapse: collapse;
        width: 100%;
        margin: 10px 0;
    }

    .message-content .markdown-content th,
    .message-content .markdown-content td {
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 8px 12px;
        text-align: left;
    }

    .message-content .markdown-content th {
        background: rgba(255, 255, 255, 0.1);
        font-weight: 600;
        color: #ffeb3b;
    }

    .input-section {
        width: 300px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .user-input, .message-input {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .user-input label, .message-input label {
        font-weight: 500;
        font-size: 1rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 10px;
        padding: 12px;
        color: #333;
        font-size: 1rem;
    }

    .user-field {
        height: 45px;
    }

    .message-field {
        height: 80px;
        resize: vertical;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .btn {
        padding: 15px 20px;
        border: none;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .send-btn {
        background: #007bff;
        color: white;
    }

    .send-btn:hover:not(:disabled) {
        background: #0056b3;
        transform: translateY(-2px);
    }

    .travel-btn {
        background: #28a745;
        color: white;
    }

    .travel-btn:hover:not(:disabled) {
        background: #1e7e34;
        transform: translateY(-2px);
    }

    .research-btn {
        background: #17a2b8;
        color: white;
    }

    .research-btn:hover:not(:disabled) {
        background: #117a8b;
        transform: translateY(-2px);
    }

    /* Scrollbar styling */
    .messages-container::-webkit-scrollbar {
        width: 6px;
    }

    .messages-container::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
    }

    .messages-container::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.3);
        border-radius: 3px;
    }

    .messages-container::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.5);
    }
</style>
