# Test configuration - replace with your actual values
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# Service Configuration
PING_SERVICE_URL=http://localhost:8000
PONG_SERVICE_URL=http://localhost:8001
MCP_SERVER_URL=http://localhost:8002
MCP_SERVER_PORT=8002

# Security
JWT_SECRET_KEY=test-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Admin Role Configuration
ADMIN_ROLE_NAME=PingPongAdmin
ADMIN_GROUP_ID=
REQUIRED_SCOPES=api://your-app-id/admin

# Development
DEBUG=true
LOG_LEVEL=INFO
